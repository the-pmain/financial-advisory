# Copy to .env and adjust for your environment.

# Site admin PIN (existing Express server: npm run dev / npm start)
ADMIN_PIN=1100

# Intake API (node server.mjs / npm run start:intake)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Storage bucket for portraits. The browser only ever sees /api/employees/:slug/photo
SUPABASE_EMPLOYEES_BUCKET=employees
ADMIN_API_KEY=
PORT=3000
